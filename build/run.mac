# ===============================
# Run setup (NO VISUALIZATION)
# ===============================
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Multi-thread
/run/numberOfThreads 40


# Initialize
/run/initialize

# ===============================
# Source setup
# ===============================
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 662 keV

# Batasi pancaran ke arah +Z (sudut kerucut 15 derajat)
/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 15 deg
/gps/ang/rot1 -1 0 0
/gps/ang/rot2 0 1 0


/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year


# ===============================
# RUN SIMULATION (WAJIB)
# ===============================
/run/beamOn 100000000
