/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# ======================================
# SINGLE THREAD
# ======================================

/run/numberOfThreads 1

/run/initialize

# ======================================
# GAMMA SOURCE
# ======================================

/gps/particle gamma

/gps/ene/type Mono

/gps/ene/mono 662 keV

# Batasi pancaran ke arah +Z (sudut kerucut 15 derajat)
/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 15 deg
/gps/ang/rot1 -1 0 0
/gps/ang/rot2 0 1 0

# ======================================
# OPTIONAL
# ======================================

/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year

# ======================================
# TOTAL EVENT
# ======================================

/run/beamOn 1000000000
